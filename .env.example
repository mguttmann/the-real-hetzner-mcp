# Only HETZNER_API_TOKEN is required. Every other value below is the default
# (see "Configuration" in README.md) and may be left out.

# --- Hetzner Cloud API ----------------------------------------------------
# Project-bound API token with read & write permissions.
# How to create one: https://docs.hetzner.com/cloud/api/getting-started/generating-api-token/
HETZNER_API_TOKEN=

# API base URL. The token is sent wherever this points. Must be https; plain
# http only for localhost, 127.0.0.1 or ::1, anything else stops the server at
# startup. The default is fine; only override for tests or a local fake upstream.
HETZNER_API_BASE=https://api.hetzner.cloud/v1

# --- Optional write guard -------------------------------------------------
# false: write tools execute directly.
# true:  write tools return a preview only unless `confirm: "YES"` is set.
HETZNER_CONFIRM_WRITES=false

# --- Optional operator switches -------------------------------------------
# Checked at call time, before the write guard; tool list and schemas stay the
# same. A blocked call returns an error and sends no request.
# true: only read-only tools run, and hcloud_raw_request only with GET.
# Anything but true/1/yes/false/0/no or empty stops the server at startup.
HETZNER_READ_ONLY=false
# Comma-separated tool name globs (* and ?), e.g. hcloud_delete_*,hcloud_raw_request
# Uses the server's own hcloud_* names; a pattern that matches no tool stops the
# server at startup. Deny hcloud_raw_request too, or denied endpoints stay
# reachable through it.
HETZNER_DENY_TOOLS=

# --- Logging --------------------------------------------------------------
# pino level: debug | info | warn | error (anything else falls back to warn).
# Logs are JSON on stderr; stdout carries the MCP protocol.
LOG_LEVEL=warn

# --- Timeouts / Polling ---------------------------------------------------
# Budget for one API request, all attempts and retry delays included.
HTTP_TIMEOUT_MS=30000
# Longest single retry delay; a 429 asking for more is returned as an error at once.
HTTP_MAX_RETRY_DELAY_MS=10000
# Wall-clock budget of a wait=true call from its start. Keep
# max(HTTP_TIMEOUT_MS, ACTION_POLL_TIMEOUT_MS) below the caller's call timeout
# (60 s in many MCP clients and gateways).
ACTION_POLL_TIMEOUT_MS=45000
ACTION_POLL_INTERVAL_MS=2000

# --- Output size ----------------------------------------------------------
# Largest tool result text in bytes (as sent, JSON-escaped). A longer result is
# cut and ends with "[output truncated by MAX_OUTPUT_BYTES=...]". Values above
# the default are lowered to it (the stdio line limit is 10 MiB).
MAX_OUTPUT_BYTES=8388608

# --- Pagination Soft-Cap --------------------------------------------------
# An auto-paginated list stops at either cap; if more items exist it reports
# truncated: true.
PAGINATION_MAX_ITEMS=500
PAGINATION_MAX_PAGES=10
# Wall-clock budget of one auto-paginated list; when it ends, the pages read so
# far come back with truncated: true and a note. Keep below the call timeout.
PAGINATION_TIMEOUT_MS=45000

# --- MCP protocol ---------------------------------------------------------
# true: also serve the 2026-07-28 revision to a client that opens with
# server/discover. A client that opens with initialize gets the same 2025-era
# session as with false. Keep false until the client is checked.
MCP_SERVE_MODERN_PROTOCOL=false
