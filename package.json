{
  "name": "@mguttmann/hetzner-cloud-mcp",
  "mcpName": "io.github.mguttmann/the-real-hetzner-mcp",
  "version": "0.2.0",
  "description": "Unofficial MCP server (stdio) for the Hetzner Cloud API: one typed tool per API operation plus hand-tuned wrappers, read and write. Not affiliated with Hetzner.",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hetzner-cloud-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "RUN_LIVE_TESTS=1 vitest run tests/live-smoke.test.ts",
    "generate": "tsx scripts/generate.ts",
    "refresh-spec": "tsx scripts/refresh-spec.ts",
    "refresh-snapshot": "tsx scripts/refresh-snapshot.ts",
    "smoke": "node scripts/smoke-stdio.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hetzner",
    "hetzner-cloud",
    "claude",
    "ai-tools",
    "stdio",
    "openapi"
  ],
  "author": "mguttmann (https://github.com/mguttmann)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguttmann/the-real-hetzner-mcp.git"
  },
  "homepage": "https://github.com/mguttmann/the-real-hetzner-mcp#readme",
  "bugs": {
    "url": "https://github.com/mguttmann/the-real-hetzner-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "dotenv": "^18.0.9",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
